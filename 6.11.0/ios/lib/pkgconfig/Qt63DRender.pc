prefix=@@QT_PREFIX@@
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
host_bins=${prefix}/bin

Name: Qt63DRender
Description: Qt63DRender module
Version: 6.11.0
Libs: -F${libdir} -framework Qt3DRender -framework Qt3DCore -framework QtCore -framework QtOpenGL -framework QtConcurrent
Cflags: -F${libdir} -I${includedir} -I${libdir}/Qt3DRender.framework/Headers -DQT_3DRENDER_LIB
Requires: Qt63DCore Qt6Core Qt6OpenGL Qt6Concurrent
