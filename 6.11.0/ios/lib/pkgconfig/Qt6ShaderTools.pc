prefix=@@QT_PREFIX@@
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
host_bins=${prefix}/bin

Name: Qt6ShaderTools
Description: Qt6ShaderTools module
Version: 6.11.0
Libs: -F${libdir} -framework QtShaderTools -framework QtCore -framework QtGui
Cflags: -F${libdir} -I${includedir} -I${libdir}/QtShaderTools.framework/Headers -DQT_SHADERTOOLS_LIB
Requires: Qt6Core Qt6Gui
