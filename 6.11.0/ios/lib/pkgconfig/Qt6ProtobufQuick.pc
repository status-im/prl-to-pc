prefix=@@QT_PREFIX@@
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
host_bins=${prefix}/bin

Name: Qt6ProtobufQuick
Description: Qt6ProtobufQuick module
Version: 6.11.0
Libs: -F${libdir} -framework QtProtobufQuick -framework QtQuick -framework QtCore -framework QtProtobuf -framework QtQml
Cflags: -F${libdir} -I${includedir} -I${libdir}/QtProtobufQuick.framework/Headers -DQT_PROTOBUFQUICK_LIB
Requires: Qt6Quick Qt6Core Qt6Protobuf Qt6Qml
