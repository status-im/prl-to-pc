prefix=@@QT_PREFIX@@
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
host_bins=${prefix}/bin

Name: Qt6QuickTemplates2
Description: Qt6QuickTemplates2 module
Version: 6.11.0
Libs: -F${libdir} -framework QtQuickTemplates2 -framework QtCore -framework QtGui -framework QtQuick -framework QtQml -framework QtQmlModels
Cflags: -F${libdir} -I${includedir} -I${libdir}/QtQuickTemplates2.framework/Headers -DQT_QUICKTEMPLATES2_LIB
Requires: Qt6Core Qt6Gui Qt6Quick Qt6Qml Qt6QmlModels
