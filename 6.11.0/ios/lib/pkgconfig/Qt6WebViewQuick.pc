prefix=@@QT_PREFIX@@
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
host_bins=${prefix}/bin

Name: Qt6WebViewQuick
Description: Qt6WebViewQuick module
Version: 6.11.0
Libs: -F${libdir} -framework QtWebViewQuick -framework QtQuick -framework QtQmlModels -framework QtWebView -framework QtOpenGL
Cflags: -F${libdir} -I${includedir} -I${libdir}/QtWebViewQuick.framework/Headers -DQT_WEBVIEWQUICK_LIB
Requires: Qt6Quick Qt6QmlModels Qt6WebView Qt6OpenGL
