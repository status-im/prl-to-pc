prefix=@@QT_PREFIX@@
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
host_bins=${prefix}/bin

Name: Qt6WebChannelQuick
Description: Qt6WebChannelQuick module
Version: 6.11.0
Libs: -F${libdir} -framework QtWebChannelQuick -framework QtCore -framework QtWebChannel
Cflags: -F${libdir} -I${includedir} -I${libdir}/QtWebChannelQuick.framework/Headers -DQT_WEBCHANNELQUICK_LIB
Requires: Qt6Core Qt6WebChannel
