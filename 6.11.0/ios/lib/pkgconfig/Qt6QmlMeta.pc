prefix=@@QT_PREFIX@@
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
host_bins=${prefix}/bin

Name: Qt6QmlMeta
Description: Qt6QmlMeta module
Version: 6.11.0
Libs: -F${libdir} -framework QtQmlMeta -framework QtQml -framework QtQmlModels -framework QtQmlWorkerScript
Cflags: -F${libdir} -I${includedir} -I${libdir}/QtQmlMeta.framework/Headers -DQT_QMLMETA_LIB
Requires: Qt6Qml Qt6QmlModels Qt6QmlWorkerScript
