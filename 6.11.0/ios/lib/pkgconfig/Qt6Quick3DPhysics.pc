prefix=@@QT_PREFIX@@
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
host_bins=${prefix}/bin

Name: Qt6Quick3DPhysics
Description: Qt6Quick3DPhysics module
Version: 6.11.0
Libs: -F${libdir} -framework QtQuick3DPhysics -framework QtCore -framework QtGui -framework QtQml -framework QtQuick -framework QtQuick3D
Cflags: -F${libdir} -I${includedir} -I${libdir}/QtQuick3DPhysics.framework/Headers -DQT_QUICK3DPHYSICS_LIB
Requires: Qt6Core Qt6Gui Qt6Qml Qt6Quick Qt6Quick3D
