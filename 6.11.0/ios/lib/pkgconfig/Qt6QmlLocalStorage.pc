prefix=@@QT_PREFIX@@
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
host_bins=${prefix}/bin

Name: Qt6QmlLocalStorage
Description: Qt6QmlLocalStorage module
Version: 6.11.0
Libs: -F${libdir} -framework QtQmlLocalStorage -framework QtSql -framework QtCore -framework QtQml
Cflags: -F${libdir} -I${includedir} -I${libdir}/QtQmlLocalStorage.framework/Headers -DQT_QMLLOCALSTORAGE_LIB
Requires: Qt6Sql Qt6Core Qt6Qml
