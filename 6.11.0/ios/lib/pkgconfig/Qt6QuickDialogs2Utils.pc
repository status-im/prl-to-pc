prefix=@@QT_PREFIX@@
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
host_bins=${prefix}/bin

Name: Qt6QuickDialogs2Utils
Description: Qt6QuickDialogs2Utils module
Version: 6.11.0
Libs: -F${libdir} -framework QtQuickDialogs2Utils -framework QtCore -framework QtGui
Cflags: -F${libdir} -I${includedir} -I${libdir}/QtQuickDialogs2Utils.framework/Headers -DQT_QUICKDIALOGS2UTILS_LIB
Requires: Qt6Core Qt6Gui
