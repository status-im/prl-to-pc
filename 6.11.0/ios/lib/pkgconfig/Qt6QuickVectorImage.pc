prefix=@@QT_PREFIX@@
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
host_bins=${prefix}/bin

Name: Qt6QuickVectorImage
Description: Qt6QuickVectorImage module
Version: 6.11.0
Libs: -F${libdir} -framework QtQuickVectorImage -framework QtQuick -framework QtSvg
Cflags: -F${libdir} -I${includedir} -I${libdir}/QtQuickVectorImage.framework/Headers -DQT_QUICKVECTORIMAGE_LIB
Requires: Qt6Quick Qt6Svg
