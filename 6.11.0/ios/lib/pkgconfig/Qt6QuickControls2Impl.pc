prefix=@@QT_PREFIX@@
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
host_bins=${prefix}/bin

Name: Qt6QuickControls2Impl
Description: Qt6QuickControls2Impl module
Version: 6.11.0
Libs: -F${libdir} -framework QtQuickControls2Impl -framework QtCore -framework QtGui -framework QtQuick -framework QtQml -framework QtQuickTemplates2
Cflags: -F${libdir} -I${includedir} -I${libdir}/QtQuickControls2Impl.framework/Headers -DQT_QUICKCONTROLS2IMPL_LIB
Requires: Qt6Core Qt6Gui Qt6Quick Qt6Qml Qt6QuickTemplates2
