prefix=@@QT_PREFIX@@
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
host_bins=${prefix}/bin

Name: Qt6Quick3DHelpers
Description: Qt6Quick3DHelpers module
Version: 6.11.0
Libs: -F${libdir} -framework QtQuick3DHelpers -framework QtQml -framework QtQuick -framework QtQuick3D -framework QtGui -framework QtConcurrent
Cflags: -F${libdir} -I${includedir} -I${libdir}/QtQuick3DHelpers.framework/Headers -DQT_QUICK3DHELPERS_LIB
Requires: Qt6Qml Qt6Quick Qt6Quick3D Qt6Gui Qt6Concurrent
