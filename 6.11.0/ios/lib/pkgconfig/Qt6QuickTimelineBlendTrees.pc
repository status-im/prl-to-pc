prefix=@@QT_PREFIX@@
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
host_bins=${prefix}/bin

Name: Qt6QuickTimelineBlendTrees
Description: Qt6QuickTimelineBlendTrees module
Version: 6.11.0
Libs: -F${libdir} -framework QtQuickTimelineBlendTrees -framework QtCore -framework QtQml -framework QtQuick -framework QtQuickTimeline
Cflags: -F${libdir} -I${includedir} -I${libdir}/QtQuickTimelineBlendTrees.framework/Headers -DQT_QUICKTIMELINEBLENDTREES_LIB
Requires: Qt6Core Qt6Qml Qt6Quick Qt6QuickTimeline
